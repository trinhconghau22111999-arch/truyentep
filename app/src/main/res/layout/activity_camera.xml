<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- 3 hàng trên cùng (tiêu đề / mô tả / tick đồng ý) thu gọn, ép sát cạnh trên -->
    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/consent_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/consent_body"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/text_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <CheckBox
        android:id="@+id/checkbox_consent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/consent_checkbox"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/text_body"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nút này bị vô hiệu hóa cho tới khi checkbox ở trên được tick -->
    <Button
        android:id="@+id/btn_generate_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/btn_generate_code"
        app:layout_constraintTop_toBottomOf="@id/checkbox_consent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hiện sau khi tạo mã thành công -->
    <LinearLayout
        android:id="@+id/layout_pairing_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btn_generate_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_pairing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_code_label" />

        <TextView
            android:id="@+id/text_pairing_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.3"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="852314" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/pairing_code_hint"
            android:textSize="13sp" />

        <!-- Nút "Chụp ảnh" và "Dừng" chỉ ẩn khỏi giao diện (visibility="gone") — vẫn giữ
             nguyên trong layout + code (CameraActivity.kt) để không phải xoá logic. -->
        <Button
            android:id="@+id/btn_take_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_take_photo"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_end_session"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/btn_end_session"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Nút "Gửi tệp" tách khỏi khối trên, ghim cố định ở góc phải-dưới màn hình.
         Ẩn mặc định — CameraActivity.kt hiện/ẩn cùng lúc với layout_pairing_code. -->
    <Button
        android:id="@+id/btn_send_file"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/btn_send_file"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/banner_battery"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Chỉ hiện khi máy CHƯA được loại trừ khỏi tối ưu pin — ẩn hẳn nếu đã bật rồi -->
    <LinearLayout
        android:id="@+id/banner_battery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF3CD"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_optim_warning"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_battery_fix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_battery_fix" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
