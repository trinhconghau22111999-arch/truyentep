<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Man hinh chup anh luon nam o doan giua man hinh (khong tran vien) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_capture_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.12" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_capture_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.88" />

    <!-- Khung camera - gio gioi han trong doan giua man hinh, khong con phu kin toan man -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top"
        app:layout_constraintBottom_toBottomOf="@id/guide_capture_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nut thoat che do chup - goc tren-trai cua doan giua -->
    <TextView
        android:id="@+id/btn_exit_capture"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_round_button"
        android:clickable="true"
        android:contentDescription="Thoát"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top" />

    <!-- Chip ma ghep noi + nut "Gui tep" - nam san TRONG man hinh chup anh (goc
         tren-phai, doi dien nut thoat), khong con la 1 man hinh rieng nua. -->
    <LinearLayout
        android:id="@+id/layout_top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top">

        <TextView
            android:id="@+id/text_pairing_code_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            tools:text="Mã: 320100" />

        <Button
            android:id="@+id/btn_send_file"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/btn_send_file"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Hang nut duoi cung: xem anh vua chup (trai, an mac dinh) - nut chup (giua) - flash (phai) -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/guide_capture_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- CHI hien sau khi da chup it nhat 1 tam trong phien nay -->
        <ImageView
            android:id="@+id/btn_view_last_photo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_round_button"
            android:clickable="true"
            android:contentDescription="Xem ảnh vừa chụp"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/btn_capture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_capture_button"
            android:clickable="true"
            android:contentDescription="Chụp ảnh"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_toggle_flash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/bg_round_button"
            android:clickable="true"
            android:contentDescription="Bật/tắt đèn flash"
            android:focusable="true"
            android:gravity="center"
            android:text="⚡"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Man hinh xem lai anh vua chup (hien ngay sau khi chup), cung nam o doan giua
         man hinh giong khung ngam. Khong con nut X - cham 1 lan vao anh (hoac bam Back)
         se dong lai khong gui; vuot 2 ngon tay tu duoi len tren anh nay se gui anh sang
         may tinh - xem PhotoCaptureActivity cho logic cu the. -->
    <FrameLayout
        android:id="@+id/layout_photo_review"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top"
        app:layout_constraintBottom_toBottomOf="@id/guide_capture_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_review_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ảnh vừa chụp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/text_review_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_round_button"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/hint_swipe_up_to_send"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
