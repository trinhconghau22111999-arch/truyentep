<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/root_photo_capture"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- Man hinh chup anh gio phong to CHIEM TRON MAN HINH (tran vien tren-duoi),
         khong con 2 vien den nhu truoc nua - guide dat dung 0%/100% de tan dung het
         chieu cao vung noi dung cua Activity. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_capture_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_capture_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="1" />

    <!-- Khung camera - gio gioi han trong doan giua man hinh, khong con phu kin toan man.
         scaleType="fitCenter" (thay vi mac dinh fillCenter) de HIEN DUNG NGUYEN KHUNG HINH,
         KHONG zoom/crop mat canh - neu ti le khung hinh camera hep hon man hinh thi tu dong
         chua 2 vien den (letterbox) o HAI BEN TRAI/PHAI thay vi phong to cat hinh. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top"
        app:layout_constraintBottom_toBottomOf="@id/guide_capture_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Trang thai ket noi - GOC TREN-TRAI man hinh chup anh, luon hien ro de nguoi dung
         biet ngay may tinh da ket noi hay chua (khong can doan qua notification). Cham
         tron (mau doi theo trang thai) + chu "Đã kết nối x/4" hoac "Chưa kết nối". -->
    <LinearLayout
        android:id="@+id/layout_connection_status"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top">

        <View
            android:id="@+id/dot_connection_status"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/text_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Chưa kết nối" />

    </LinearLayout>

    <!-- Chip ma ghep noi + nut "Gui tep" - nam san TRONG man hinh chup anh (goc
         tren-phai), khong con la 1 man hinh rieng nua. -->
    <LinearLayout
        android:id="@+id/layout_top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top">

        <TextView
            android:id="@+id/text_pairing_code_chip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            tools:text="Mã: 320100" />

        <Button
            android:id="@+id/btn_send_file"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_send_file"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Nut den flash - DA DOI len 1 hang, nam NGAY PHIA TREN hang nut duoi cung
         (bottom_controls), van ghim gan canh phai man hinh nhu cu. -->
    <ImageView
        android:id="@+id/btn_toggle_flash"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_round_button"
        android:clickable="true"
        android:contentDescription="Bật/tắt đèn flash"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_flash_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls" />

    <!-- Hang nut duoi cung - doi tu LinearLayout sang ConstraintLayout de nut chup LUON
         NAM CHINH GIUA man hinh (khong bi lech khi nut xem-anh-vua-chup dang an), va nut
         flash LUON nam gan CANH PHAI (ghim theo canh man hinh, khong dinh sat nut chup) -
         giong bo cuc quen thuoc cua cac app camera: xem-anh-vua-chup (trai) - chup (giua) -
         flash (phai), on dinh du dang o trang thai nao.
         SUA: nut flash da doi len 1 hang phia tren (xem @id/btn_toggle_flash o tren) -
         vi tri cu (canh phai, ngang hang nut chup) gio la nut doi camera truoc/sau. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="@id/guide_capture_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nut chup - CHINH GIUA man hinh theo chieu ngang, khong phu thuoc cac nut khac -->
        <View
            android:id="@+id/btn_capture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_capture_button"
            android:clickable="true"
            android:contentDescription="Chụp ảnh"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- CHI hien sau khi da chup it nhat 1 tam trong phien nay - ghim gan canh trai -->
        <ImageView
            android:id="@+id/btn_view_last_photo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_round_button"
            android:clickable="true"
            android:contentDescription="Xem ảnh vừa chụp"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_capture"
            app:layout_constraintBottom_toBottomOf="@id/btn_capture" />

        <!-- Nut doi camera truoc/sau - o DUNG VI TRI CU cua nut flash (gan canh phai,
             ngang hang nut chup). -->
        <ImageView
            android:id="@+id/btn_switch_camera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_round_button"
            android:clickable="true"
            android:contentDescription="Đổi camera trước/sau"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_camera_switch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_capture"
            app:layout_constraintBottom_toBottomOf="@id/btn_capture" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Man hinh xem lai anh vua chup (hien ngay sau khi chup), cung nam o doan giua
         man hinh giong khung ngam. Khong con nut X - cham 1 lan vao anh (hoac bam Back)
         se dong lai khong gui; vuot 2 ngon tay tu duoi len tren anh nay se gui anh sang
         may tinh - xem PhotoCaptureActivity cho logic cu the. -->
    <FrameLayout
        android:id="@+id/layout_photo_review"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/guide_capture_top"
        app:layout_constraintBottom_toBottomOf="@id/guide_capture_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_review_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ảnh vừa chụp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/text_review_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_round_button"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/hint_swipe_up_to_send"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
